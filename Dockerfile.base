ARG ALPINE_VERSION="3.18"

ARG OSX_SDK="MacOSX15.0.sdk"
ARG OSX_SDK_URL="https://github.com/joseluisq/macosx-sdks/releases/download/15.0/${OSX_SDK}.tar.xz"

ARG OSX_CROSS_COMMIT="27d21e4977c9751d01199c7a226a6faf494c3dd9"

ARG CROSSTOOL_REPO_REF="26354bd1b69cba20f8129c6be379556f627c7443"

# Get the macOS SDK
FROM alpine:${ALPINE_VERSION} AS sdk
RUN apk --update --no-cache add ca-certificates curl
ARG OSX_SDK
ARG OSX_SDK_URL
RUN curl -sSL "$OSX_SDK_URL" -o "/$OSX_SDK.tar.xz"

# Get the osxcross source
FROM alpine:${ALPINE_VERSION} AS osxcross-src
RUN apk --update --no-cache add git
ARG OSX_CROSS_COMMIT
RUN git clone 'https://github.com/tpoechtrager/osxcross.git' /osxcross-src && \
    cd /osxcross-src && \
    git checkout --progress --force $OSX_CROSS_COMMIT && \
    git submodule update --init --recursive

# Build the macOS host compilers for the canadian builds
FROM ubuntu:noble AS build-osxcross
COPY support/packages.txt /tmp/packages.txt
RUN export DEBIAN_FRONTEND="noninteractive" \
  && apt-get update \
  && xargs -a /tmp/packages.txt apt-get install --no-install-recommends -y \
  && apt-get clean \
  && rm -rf /var/cache/apt/archives /var/lib/apt/lists
ARG OSX_SDK
COPY --link --from=osxcross-src /osxcross-src /tmp/osxcross-src
COPY --link --from=sdk /$OSX_SDK.tar.xz /tmp/osxcross-src/tarballs/$OSX_SDK.tar.xz
COPY support/build-osxcross.sh /tmp/build-osxcross.sh
RUN /tmp/build-osxcross.sh /tmp/osxcross-src /osxcross

# Build crosstool-ng
FROM build-osxcross AS build-crosstool-ng
ARG CROSSTOOL_REPO_REF
RUN git clone https://github.com/crosstool-ng/crosstool-ng.git /tmp/crosstool-ng \
    && cd /tmp/crosstool-ng \
    && git checkout --progress --force $CROSSTOOL_REPO_REF \
    && ./bootstrap \
    && ./configure --prefix=/ct-ng \
    && make -j$(nproc) \
    && make install

# Final image
FROM ubuntu:noble AS final
COPY support/packages.txt /tmp/packages.txt
RUN export DEBIAN_FRONTEND="noninteractive" \
  && apt-get update \
  && xargs -a /tmp/packages.txt apt-get install --no-install-recommends -y \
  && apt-get clean \
  && rm -rf /var/cache/apt/archives /var/lib/apt/lists \
  && rm /tmp/packages.txt

COPY --from=build-crosstool-ng /ct-ng /ct-ng
COPY --from=build-crosstool-ng /osxcross /osxcross

# Remove the ubuntu user and group
USER 0:0
RUN userdel ubuntu || true && groupdel ubuntu || true

# Ensure search paths for libraries are up to date
RUN rm /etc/ld.so.cache && ldconfig

# Runtime shell init script to ensure the user is created with the correct UID/GID for the mountpoint
COPY support/init.sh /init.sh
RUN chmod +x /init.sh

ENTRYPOINT ["/init.sh"]
CMD ["bash"]
